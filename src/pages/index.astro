---
import { Image } from 'astro:assets'

import alertLine from '../assets/alert-line.svg'
import distroboxIcon from '../assets/distrobox.svg'
import flatpakIcon from '../assets/flatpak.svg'
import fullscreenExitLine from '../assets/fullscreen-exit-line.svg'
import githubLine from '../assets/github-line.svg'
import matrixLine from '../assets/matrix-line.svg'
import redditLine from '../assets/reddit-line.svg'
import refreshLine from '../assets/refresh-line.svg'
import telegramLine from '../assets/telegram-line.svg'
import toolsLine from '../assets/tools-line.svg'
import userCommunityLine from '../assets/user-community-line.svg'
import Layout from '../layouts/Layout.astro'
---

<Layout>
    <div id="content">
        <section class="section-jumbotron">
            <div class="container">
                <div class="warning-container">
                    <div class="warning" role="alert">
                        <Image src={alertLine} alt="Alert" />
                        <span>Aeon is still in a Release Candidate stage!</span>
                    </div>
                </div>
                <div class="jumbotron-container">
                    <div class="jumbotron-image-wrapper">
                        <iframe
                            class="jumbotron-image"
                            width="600"
                            height="360"
                            src="https://www.youtube.com/embed/1K_kGbmlewo"
                            title="openSUSE Aeon - Desktop Linux Finally Done Right? Video on YouTube"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen></iframe>
                    </div>
                    <div class="jumbotron-content">
                        <h1 class="jumbotron-title">Welcome to Aeon Desktop</h1>
                        <p class="jumbotron-text">
                            The Linux Desktop for people who want to "get stuff
                            done"
                        </p>
                        <a
                            class="jumbotron-button"
                            target="_blank"
                            href="https://download.opensuse.org/tumbleweed/appliances/Aeon-Installer.x86_64.raw.xz"
                            >Download</a
                        >
                        <a
                            class="jumbotron-button"
                            target="_blank"
                            href="https://en.opensuse.org/Portal:Aeon/InstallGuide"
                            >Install Guide</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <section id="features" class="section-features">
            <div class="container">
                <h2 class="features-title">Features</h2>
                <div class="features-grid">
                    <div class="feature-card">
                        <h3 class="feature-title">
                            <div class="feature-icon">
                                <Image
                                    class="flip"
                                    src={toolsLine}
                                    alt="Tools icon"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            Automated Maintenance
                        </h3>
                        <p class="feature-text">
                            Daily system updates happen automatically while you
                            work. Your running system is not affected until you
                            reboot, keeping your workday consistent and avoiding
                            any unexpected issues with your apps.
                        </p>
                    </div>
                    <div class="feature-card">
                        <h3 class="feature-title">
                            <div class="feature-icon">
                                <Image
                                    class="flip"
                                    src={fullscreenExitLine}
                                    alt="Fullscreen icon"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            Minimal Yet Functional
                        </h3>
                        <p class="feature-text">
                            The base system is kept small and simple, but with
                            everything you need for getting straight on with
                            your tasks - including programming, gaming, media
                            production and clerical work.
                        </p>
                    </div>
                    <div class="feature-card">
                        <h3 class="feature-title">
                            <div class="feature-icon">
                                <Image
                                    class="flip"
                                    src={distroboxIcon}
                                    alt="Distrobox icon"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            Distrobox
                        </h3>
                        <p class="feature-text">
                            Aeon ships with <a
                                href="https://distrobox.it/"
                                target="_blank">Distrobox</a
                            > configured to launch Tumbleweed containers, perfect
                            for your development tools and projects in their own
                            little containerized environments.
                        </p>
                    </div>
                    <div class="feature-card">
                        <h3 class="feature-title">
                            <div class="feature-icon">
                                <Image
                                    class="flip"
                                    src={flatpakIcon}
                                    alt="Flatpak icon"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            Flatpak
                        </h3>
                        <p class="feature-text">
                            <a href="https://flatpak.org/" target="_blank"
                                >Flatpak</a
                            > is already set up to let you install any app from a
                            vast catalogue available from
                            <a href="https://flathub.org/" target="_blank"
                                >Flathub</a
                            >. Just click install and go.
                        </p>
                    </div>
                    <div class="feature-card">
                        <h3 class="feature-title">
                            <div class="feature-icon">
                                <Image
                                    class="flip"
                                    src={refreshLine}
                                    alt="Refresh icon"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            Transactional Update
                        </h3>
                        <p class="feature-text">
                            The same base technologies powering MicroOS are
                            here, to ensure long and steady operation of your
                            computer and its software.
                        </p>
                    </div>
                    <div class="feature-card">
                        <h3 class="feature-title">
                            <div class="feature-icon">
                                <Image
                                    class="flip"
                                    src={userCommunityLine}
                                    alt="Community icon"
                                    width={32}
                                    height={32}
                                />
                            </div>
                            Community
                        </h3>
                        <p class="feature-text">
                            Large, knowledgable community gives you an
                            opportunity to learn, troubleshoot and make full use
                            of your new operating system with help of other
                            people.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="who-is-aeon-for" class="section-who-is-for">
            <div class="container">
                <h2 class="who-is-for-title">Who is Aeon For?</h2>
                <div class="who-is-for-grid">
                    <div class="who-is-for-card">
                        <h3>Beginners</h3>
                        <p>
                            The OS is static, automated and reliable, letting
                            you focus on your apps and work.
                        </p>
                    </div>
                    <div class="who-is-for-card">
                        <h3>"Lazy Developer"</h3>
                        <p>
                            Spend your time getting things done while letting
                            your desktop take care of itself.
                        </p>
                    </div>
                    <div class="who-is-for-card">
                        <h3>Anyone</h3>
                        <p>If you like a computer that "just works".</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="community" class="section-community">
            <div class="container">
                <h2 class="community-title">Join the Community</h2>
                <p class="community-text">
                    The Aeon community is full of passionate, friendly, and
                    talented individuals working together to build something
                    amazing. Whether you're here to contribute, learn, or just
                    hang out, you're always welcome!
                </p>
                <p class="community-text">
                    Looking for technical details and how-tos? Check out the <a
                        target="_blank"
                        href="https://en.opensuse.org/Portal:Aeon">Aeon Wiki</a
                    > for in-depth guides and documentation.
                </p>
                <p class="community-text">
                    Have a bug to report? We appreciate your help in making Aeon
                    even better! Head over to <a
                        target="_blank"
                        href="https://bugzilla.opensuse.org/enter_bug.cgi?product=openSUSE+Aeon&format=guided"
                        >Bugzilla</a
                    > and follow our <a
                        target="_blank"
                        href="https://en.opensuse.org/openSUSE:Submitting_bug_reports"
                        >Submitting Bug Reports</a
                    > guide to ensure your report is detailed and helpful.
                </p>
                <p class="community-text">
                    Got questions or just want to chat? Join one of our chat
                    rooms, where you’ll find helpful folks ready to discuss the
                    project, share ideas, and collaborate in real time. We can’t
                    wait to meet you!
                </p>
                <div class="community-links">
                    <a
                        href="https://github.com/AeonDesktop/"
                        target="_blank"
                        class="community-link"
                    >
                        <Image
                            class="flip"
                            src={githubLine}
                            alt="GitHub icon"
                            width={32}
                            height={32}
                        />
                        GitHub
                    </a>
                    <a
                        href="https://t.me/AeonDesktop"
                        target="_blank"
                        class="community-link"
                    >
                        <Image
                            class="flip"
                            src={telegramLine}
                            alt="Telegram icon"
                            width={32}
                            height={32}
                        />
                        Telegram
                    </a>
                    <a
                        href="https://matrix.to/#/#aeon:opensuse.org"
                        target="_blank"
                        class="community-link"
                    >
                        <Image
                            class="flip"
                            src={matrixLine}
                            alt="Matrix icon"
                            width={32}
                            height={32}
                        />
                        Matrix
                    </a>
                    <a
                        href="https://www.reddit.com/r/AeonDesktop/"
                        target="_blank"
                        class="community-link"
                    >
                        <Image
                            class="flip"
                            src={redditLine}
                            alt="GitHub icon"
                            width={32}
                            height={32}
                        />
                        Reddit
                    </a>
                </div>
            </div>
        </section>
    </div>
</Layout>
