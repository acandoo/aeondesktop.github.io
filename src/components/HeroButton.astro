---
interface Props {
    type: 'primary' | 'secondary'
    href: string
}

const { type, href }: Props = Astro.props
---

<a class:list={['jumbotron-button', type]} target="_blank" href={href}>
    <slot />
</a>
<style>
    .jumbotron-button {
        display: inline-block;
        padding: 1rem 2rem;

        /* This is a little hacky but it keeps the buttons left aligned */
        margin-right: 1rem;

        border-radius: 3rem;
        font-size: 1.2rem;
        transition: all var(--transition-duration) ease;
        text-decoration: none;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }
    .jumbotron-button:hover {
        scale: 1.05;
        filter: brightness(1.3);
    }
    .primary {
        background-color: var(--primary-button-color);
        color: var(--text-color-dark);
    }
    .secondary {
        background-color: var(--secondary-button-color);
        color: var(--text-color-light);
    }
</style>
